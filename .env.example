# Public local-development settings only. Copy to .env.local and adjust for your Alpha node.
VITE_ALPHA_CHAIN_ID=alpha-1
VITE_ALPHA_CHAIN_NAME=Alpha Local
VITE_ALPHA_RPC_URL=/alpha-rpc
VITE_ALPHA_REST_URL=/alpha-rest
VITE_ALPHA_PREFIX=cosmos
VITE_ALPHA_TRANSFER_DENOM=token
VITE_ALPHA_FEE_DENOM=stake
VITE_ALPHA_COIN_TYPE=118
VITE_ALPHA_COIN_DECIMALS=0
VITE_MIDDLEWARE_API_URL=/api
VITE_KEYCLOAK_URL=http://127.0.0.1:18080
VITE_KEYCLOAK_REALM=alpha
VITE_KEYCLOAK_CLIENT_ID=authz-console

# Vite development proxy targets (server-side only; not exposed to browser code).
ALPHA_RPC_PROXY_TARGET=http://127.0.0.1:26657
ALPHA_REST_PROXY_TARGET=http://127.0.0.1:1317
MIDDLEWARE_API_PROXY_TARGET=https://127.0.0.1:8080
